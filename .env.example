# Copy to .env.local for local development: cp .env.example .env.local
# Also add these variables in Vercel (Settings -> Environment Variables).
# NEXT_PUBLIC_* values are bundled into the browser, so never put secrets here.

# Sitecore Media Library folder where "Save to Media Library" uploads the carousel PDF.
NEXT_PUBLIC_MEDIA_FOLDER=/sitecore/media library/Images

# Brand color used for the carousel and email (hex, e.g. #2f5bd3). There is no picker in the UI.
NEXT_PUBLIC_BRAND_COLOR=#2f5bd3

# Public site URL, used when the rendered page HTML has no canonical URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional fallback brand kit id for sites that have no brand kit assigned. Normally leave it
# empty: the app uses the brand kit assigned to the site of the open page. Needs "AI skills APIs"
# enabled for the app in App Studio, and the app updated in every organization.
NEXT_PUBLIC_BRAND_KIT_ID=

# Optional. Names to show for brand kits, as JSON keyed by brand kit id (the panel shows the id
# until a name is added; hover the id to see it in full). The SDK gives the app a kit's id, not its name.
# NEXT_PUBLIC_BRAND_KIT_NAMES='{"<brand kit id>": "Brand Kit Example"}'

# AI Gateway model ids (provider/model). Read when the agent is built, so after changing
# them on Vercel, redeploy.
# Main agent: plans, writes the carousel and assembles the kit.
AGENT_MODEL=openai/gpt-6-luna

# brand_editor subagent: reviews the drafts against the page and the brand guidance.
BRAND_EDITOR_MODEL=openai/gpt-6-luna

# Optional. social_ads_writer and email_builder default to AGENT_MODEL.
# SOCIAL_ADS_WRITER_MODEL=openai/gpt-6-luna
# EMAIL_BUILDER_MODEL=openai/gpt-6-luna

# VERCEL_OIDC_TOKEN is not listed on purpose: `npx eve link` / `vercel env pull`
# writes it to .env.local and it expires after about 12 hours.
