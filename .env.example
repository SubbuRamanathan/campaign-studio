# Copy to .env.local for local development: cp .env.example .env.local
# Also add these variables in Vercel (Settings -> Environment Variables).
# NEXT_PUBLIC_* values are bundled into the browser, so never put secrets here.

# Lets the server read the whole brand kit, so the writers follow its tone of voice and the carousel
# and email follow its visual guidelines. Create the credential in the Sitecore Cloud Portal:
# Stream > Admin > AI APIs keys > Create credential. Server-only secrets: never prefix them with
# NEXT_PUBLIC_. Without them the content is written without brand rules and the page's own theme
# color is used.
SITECORE_AI_CLIENT_ID=
SITECORE_AI_CLIENT_SECRET=

# AI Gateway model ids (provider/model). Read when the agent is built, so after changing
# them on Vercel, redeploy.
# Main agent: plans the campaign and assembles the kit.
AGENT_MODEL=openai/gpt-6-luna

# brand_editor subagent: reviews the drafts against the page and the brand guidance.
BRAND_EDITOR_MODEL=openai/gpt-6-luna

# Optional. The writing subagents default to AGENT_MODEL.
# SOCIAL_ADS_WRITER_MODEL=openai/gpt-6-luna
# EMAIL_BUILDER_MODEL=openai/gpt-6-luna
# CAROUSEL_WRITER_MODEL=openai/gpt-6-luna

# AI Gateway provider routing, used by every agent (see lib/model.ts). Comma-separated, first to
# last; Gateway fails over to the next provider on errors. Default: openai,azure.
# BYOK keys for these providers are added in the Vercel dashboard (AI Gateway), not here.
AGENT_PROVIDER_ORDER=openai,azure
# Optional. Allow-list: Gateway never uses a provider outside it (no failover elsewhere).
# Set it when data must stay with one provider, e.g. azure.
# AGENT_PROVIDER_ONLY=azure

# VERCEL_OIDC_TOKEN is not listed on purpose: `npx eve link` / `vercel env pull`
# writes it to .env.local and it expires after about 12 hours.
